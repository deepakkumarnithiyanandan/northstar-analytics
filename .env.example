POSTGRES_DB=northstar
POSTGRES_USER=northstar
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://northstar:replace-with-a-local-password@db:5432/northstar

# Optional. Leave blank to use deterministic local analytics responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_ROWS=100000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173